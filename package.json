{
  "name": "spalam",
  "version": "0.1.0",
  "description": "TypeScript-based WebAR library for real-time plane detection and tracking using computer vision",
  "keywords": [
    "webxr",
    "ar",
    "augmented-reality",
    "computer-vision",
    "plane-detection",
    "depth-estimation",
    "threejs",
    "typescript"
  ],
  "homepage": "https://github.com/raihara3/SPALAM",
  "bugs": {
    "url": "https://github.com/raihara3/SPALAM/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raihara3/SPALAM.git"
  },
  "license": "Apache-2.0",
  "author": "raihara3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "build:demo": "vite build --config vite.config.demo.ts",
    "build:types": "tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "preview:demo": "vite preview --config vite.config.demo.ts",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "happy-dom": "^20.0.11",
    "prettier": "^3.5.3",
    "terser": "^5.41.0",
    "typedoc": "^0.28.15",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.50.1",
    "vite": "^6.2.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@huggingface/transformers": "3.0.0",
    "@types/three": "^0.175.0",
    "three": "^0.175.0"
  }
}
